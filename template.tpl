___TESTS___

scenarios:
- name: Script loads successfully
  code: |2

    const mockData = {
        siteCode: 'test123',
        domainMenu: 'kameleoon.io'
    };

    const scriptUrl = 'https://test123.kameleoon.io/engine.js';

    mock('queryPermission', () => true);

    mock('injectScript', function(url, onSuccess, onFailure, cacheToken) {
        assertThat(url).isEqualTo(scriptUrl);
        assertThat(cacheToken).isEqualTo(scriptUrl);

        assertThat(onSuccess).isFunction();
        assertThat(onFailure).isFunction();

        onSuccess();
    });

    runCode(mockData);

    assertApi('injectScript').wasCalled();
    assertApi('gtmOnSuccess').wasCalled();
    assertApi('gtmOnFailure').wasNotCalled();
